// Load the dataset natively into a Matrix Arrow buffer!
X = read_csv("data.csv");

// User Defined Function representing a Neural Network layer
fn dense_layer(input) {
    W = [0.5, -0.2, 0.1, 0.8, -0.5, 0.9, -0.4, 0.3, 0.7, -0.1];
    
    // Matrix Dot Product
    Z = input @ W;
    
    // Activation function
    A = relu(Z);
    
    // Return expression
    return A;
}; // Semicolon required by grammar

// Forward Pass
output = dense_layer(X);

// Trigger Autograd backpropagation (Gradient Tape initialization)
backward(output);

output;
